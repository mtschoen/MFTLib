<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>x64;x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <PackageId>MFTLib</PackageId>
    <Authors>Matt Schoen</Authors>
    <Description>Fast NTFS file indexing and change tracking for .NET 10 on Windows x64 and Linux x64. Reads the Master File Table (MFT) through a native C++ core, resolves paths, filters filenames, follows the USN journal, and can isolate elevated volume access in one reusable broker process.</Description>
    <PackageProjectUrl>https://github.com/mtschoen/MFTLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mtschoen/MFTLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ntfs;mft;usn-journal;filesystem;windows;linux;file-indexing;file-enumeration</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NuGet health checks -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- Enabled in CI so builds produce deterministic DLLs while local builds keep real source paths. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MFTLib.Tests" />
    <InternalsVisibleTo Include="MFTLibTestExtensions" />
    <InternalsVisibleTo Include="Benchmark" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\MFTLibNative\MFTLibNative.vcxproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Linux: copy CMake-built libMFTLibNative.so into the bin output so consumers find it. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <None Include="..\build\linux-coverage\libMFTLibNative.so" Condition="Exists('..\build\linux-coverage\libMFTLibNative.so')">
      <Link>libMFTLibNative.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\build\linux\libMFTLibNative.so" Condition="!Exists('..\build\linux-coverage\libMFTLibNative.so') And Exists('..\build\linux\libMFTLibNative.so')">
      <Link>libMFTLibNative.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pack the native DLL into the NuGet package (Windows only: the vcxproj output) -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\x64\$(Configuration)\MFTLibNative.dll" Pack="true" PackagePath="runtimes/win-x64/native" Visible="false" />
  </ItemGroup>

  <!-- Pack the Release linux-x64 library that scripts/build-linux-native.ps1 or the CI linux-package job builds and
       passes in as MFTLibLinuxNativeLibrary. Never the coverage build. Test-ReleasePackages.ps1 rejects a release
       package that lacks it. -->
  <ItemGroup Condition="'$(MFTLibLinuxNativeLibrary)' != ''">
    <None Include="$(MFTLibLinuxNativeLibrary)" Pack="true" PackagePath="runtimes/linux-x64/native/libMFTLibNative.so" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\MFTLib.targets" Pack="true" PackagePath="build" />
    <None Include="build\MFTLib.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
