<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86</Platforms>
    <DefineConstants>$(DefineConstants);SAMPLE_WATCH</DefineConstants>
  </PropertyGroup>

  <!-- Windows: build native DLL via MSBuild vcxproj -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\MFTLibNative\MFTLibNative.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MFTLib\MFTLib.csproj" />
  </ItemGroup>

  <!-- The elevation flow and the unattended switch live once and compile into both samples. -->
  <ItemGroup>
    <Compile Include="..\SampleProgram.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MFTLib.Tests" />
  </ItemGroup>

</Project>
