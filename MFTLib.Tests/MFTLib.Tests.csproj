<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="RemoveMSTestImplicitUsing" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MFTLib\MFTLib.csproj" />
    <ProjectReference Include="..\MFTLibTestExtensions\MFTLibTestExtensions.csproj" />
  </ItemGroup>

  <!-- The caller gate reads the library's IL (constructor stores), which coverlet rewrites in the test output copy
       during a coverage run. The library project's own output is never instrumented. Its resolved path comes from the
       project reference itself, so it holds on every platform and layout. -->
  <Target Name="RecordLibraryOutput" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_LibraryOutput Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'MFTLib.dll'" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>MFTLib.UninstrumentedOutput</_Parameter1>
        <_Parameter2>@(_LibraryOutput->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="PublicSurface\*.approved.txt" CopyToOutputDirectory="Always" Link="PublicSurface\%(Filename)%(Extension)" />
    <None Include="..\AGENTS.md" Link="repository-docs\AGENTS.md"
          CopyToOutputDirectory="Always" />
    <None Include="..\docs\*.md" Link="repository-docs\docs\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Windows: build the native vcxproj. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\MFTLibNative\MFTLibNative.vcxproj" />
  </ItemGroup>

  <!-- Both samples and Benchmark build and test on every platform. -->
  <ItemGroup>
    <ProjectReference Include="..\SampleProgram.Direct\SampleProgram.Direct.csproj" />
    <ProjectReference Include="..\SampleProgram.Watch\SampleProgram.Watch.csproj" />
    <ProjectReference Include="..\Benchmark\Benchmark.csproj" />
  </ItemGroup>

  <!-- Coverlet include filter: restrict coverage to our four assemblies.
       Conditioned on CollectCoverage=true so it only applies during coverage runs.
       This sidesteps the PS7 + dotnet CLI + MSBuild comma-splitting issue that
       prevented passing -p:Include on the command line. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>[MFTLib]*,[SampleProgram.Direct]*,[SampleProgram.Watch]*,[Benchmark]*,[MFTLibTestExtensions]*</Include>
  </PropertyGroup>

  <Import Project="..\MFTLibNative.Linux.props" />

  <!-- Linux leaves out only tests whose subject is a Windows-only API that cannot be faked. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <!-- Real WMI queries: System.Management throws PlatformNotSupportedException off Windows. -->
    <Compile Remove="SystemInfoWmiTests.cs" />
  </ItemGroup>

</Project>
