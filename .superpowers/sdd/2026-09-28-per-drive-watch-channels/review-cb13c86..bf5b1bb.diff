+
+    static IntPtr BuildJournalInfoPointer(ulong maximumSize, ulong allocationDelta)
+    {
+        var pointer = Marshal.AllocHGlobal(Marshal.SizeOf<UsnJournalInfoNative>());
+        Marshal.StructureToPtr(new UsnJournalInfoNative
