    [TestMethod]
    public async Task Open_CatchUpLostTwiceThenHolds_DriveReadyAndReportedOnce()
    {
        using var scenario = new OpenScenario();
        scenario.ScriptLoss('T');
        scenario.ScriptLoss('T');

        await using var opened = new BoundedIndex(await FileIndex.OpenAsync(scenario.Options("TU"), Token).WaitAsync(HangGuard));

        var index = opened.Index;

        Assert.AreEqual(3, scenario.ProductionsOf('T'));
        Assert.AreEqual(1, scenario.ProductionsOf('U'));
        var drive = index.Drives.Single(candidate => candidate.DriveLetter == 'T');
        Assert.AreEqual(DriveState.Ready, drive.State);
        Assert.AreEqual(0, drive.ConsecutiveLostCatchUps);
        Assert.AreEqual(OpenScenario.Loss('T'), drive.CheckpointLoss);
        Assert.AreEqual(1, scenario.ReportsFor('T').Count(), "the drive reports when it settles, once");
        CollectionAssert.AreEqual(
            new[] { OpenScenario.CanonicalBlockName('T'), OpenScenario.CanonicalBlockName('U') }
