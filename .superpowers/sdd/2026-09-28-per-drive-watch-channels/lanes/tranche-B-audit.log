  if ("'$path -match '"'JournalBrokerScanSession') { return 'No. JournalBrokerScanSession was deleted; BrokerProcess owns independent scan and watch channels.' }
  if ("'$path -match '"'JournalBrokerHostBlockScan|JournalBrokerHostTests\\.Progress|JournalBrokerHostTests\\.Scan') { return 'Yes in the channel contract. JournalBrokerHost.RunScanAsync and JournalBrokerHost.RunProgressPumpAsync.' }
  if ("'$path -match '"'JournalBrokerHostTests\\.WatchArmEpoch|JournalBrokerHostTests\\.WatchArming') { return 'No. Arm epochs, DisarmDrive, and EndWatch are absent; JournalBrokerHost.StreamWatchAsync closes with its drive channel.' }
  if ("'$path -match '"'JournalBrokerHost') { return 'Changed. Related host behavior remains in JournalBrokerHost.ServeAsync and JournalBrokerHost.ServeChannelAsync.' }
  if ("'$path -match '"'VolumeQueryClient') { return 'Yes in singular form. BrokerProcess.QueryVolumeAsync.' }
  if ("'$path -match '"'VolumeQueryHost') { return 'Yes in singular form. JournalBrokerHost.HandleQueryVolumeAsync.' }
  if ("'$path -match '"'VolumeQueryScanSession') { return 'Changed. BrokerProcess.QueryVolumeAsync and BrokerProcess.ScanDriveAsync replace the scan session.' }
  if ("'$path -match '"'GrowUsnJournal') { return 'Yes in current control form. BrokerProcess.GrowUsnJournalAsync and JournalBrokerHost.HandleGrowUsnJournalAsync.' }
  if ("'$path -match '"'Index/FileIndexWatchCatchUp') {
