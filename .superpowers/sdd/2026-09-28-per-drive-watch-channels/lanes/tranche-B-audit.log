  if ("'$path -match '"'Index/FileIndexWatchStartReadiness') { return 'Changed. FileIndex.StartWatchingAsync(char, CancellationToken) awaits IIndexWatchSource.StartAsync returning a live handle; no session readiness callback remains.' }
  if ("'$path -match '"'Index/FileIndexWatchRescan|Index/FileIndexRescanCleanup') { return 'No in the session, disarm, or re-arm shape. Per-drive recovery is FileIndex.RescanAsync and RetireWatchForRescanAsync.' }
  if ("'$path -match '"'Index/FileIndex') { return 'Changed. The related behavior is per-drive in FileIndex.StartWatchingAsync, StopWatchingAsync, RescanAsync, and PumpAsync.' }
