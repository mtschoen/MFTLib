function Get-TestInventory([string]"'$revision) {
  $items = [Collections.Generic.List[object]]::new()
  $pattern = '"'(?ms)(?<attrs>(?:"'^[ '"\\t]*\\[["'^'"\\]\\r\\n]+\\][ \\t]*\\r?\\n)+)"'^[ '"\\t]*(?:public|internal|private|protected)\\s+(?:async\\s+)?["'^'"\\r\\n{;=]*?\\b(?<name>[A-Za-z_]\\w*)[ \\t]*\\('
  foreach ("'$path in @(git ls-tree -r --name-only $revision -- MFTLib.Tests MFTLibTestExtensions | Where-Object { $_ -like '"'*.cs' })) {
    "'$source = (git show "$($revision):$path") -join [char]10
    foreach ($match in [regex]::Matches($source, $pattern)) {
      $attributes = $match.Groups['"'attrs'].Value
      if ("'$attributes -notmatch '"'\\[(?:Data)?TestMethod(?:Attribute)?(?:\\(|\\])') { continue }
      "'$dataRows = @([regex]::Matches($attributes, '"'(?m)"'^'"\\s*\\[DataRow(?<row>["'^'"\\]]*)\\]') | ForEach-Object { "'$_.Groups['"'row'].Value.Trim() })
      "'$items.Add([pscustomobject]@{ Path=$path; Name=$match.Groups['"'name'].Value; DataRows="'$dataRows })
    }
  }
  return $items
}
function Get-Tranche([string]$path) {
  $leaf = [IO.Path]::GetFileName($path)
  if ($leaf -match '"'"'^(Broker|JournalBroker|VolumeQuery|GrowUsnJournal|MftProducer|DefaultElevated|ElevatedEntry)'"' -or
      ("'$path -like '"'MFTLib.Tests/TestSupport/*' -and "'$leaf -match '"'Broker|Watch|Frame|Stream')) { return 'B' }
  return 'I'
}
function Get-Description("'$item) {
  $parts = $item.Name -split '"'_', 2
  "'$subject = [regex]::Replace($parts[0], '"'(?<=[a-z0-9])(?=[A-Z])', ' ')
  "'$assertion = if ($parts.Count -gt 1) { [regex]::Replace($parts[1], '"'(?<=[a-z0-9])(?=[A-Z])', ' ') } else { 'the named behavior' }
  "'$value = "Exercised $subject and asserted $assertion."
  if ($item.DataRows.Count -gt 0) { $value += '"' DataRows: ' + ("'$item.DataRows -join '"'; ') + '.' }
  return "'$value
}
function Get-Behavior($item) {
  $path = $item.Path
  $name = $item.Name
  if ($path -match '"'BrokerArmEpoch|BrokerArmOrdering') { return 'No. Arm epochs and the shared demux are absent; BrokerProcess.OpenWatchChannelAsync.' }
  if ("'$path -match '"'BrokerProtocol') { return 'No in the base wire shape. The current contract is BrokerFrame and BrokerFrameKind over one drive channel.' }
  if ("'$path -match '"'BrokerIndexWatchSource|BrokerPerDriveArm|BrokerLiveWatch|BrokerDeath|BrokerWatch') { return 'No in the shared-stream shape. The current path is BrokerIndexWatchSource.StartAsync and BrokerProcess.OpenWatchChannelAsync.' }
  if ("'$path -match '"'BrokerFileIndexRescan') { return 'Changed. Per-drive restart exists in FileIndex.RescanAsync and BrokerProcess.OpenWatchChannelAsync.' }
  if ("'$path -match '"'BrokerMftBlockProducer|MftProducer') { return 'Changed. Single-drive production exists in BrokerMftBlockProducer.ProduceAsync and BrokerProcess.ScanDriveAsync.' }
  if ("'$path -match '"'JournalBrokerClientTests\\.ConnectionAndWatchFailures') {
    if ("'$name -match '"'SpawnAndConnect') { return 'Yes in renamed form. BrokerProcess.LaunchAsync.' }
    if ("'$name -match '"'TryNormalizeDriveLetter') { return 'Changed. BrokerProcess.NormalizeDrive accepts a drive letter, not the old string helper.' }
    return 'No in the shared-watch form. BrokerProcess.DisposeAsync and per-drive BrokerDriveChannel disposal replace it.'
  }
