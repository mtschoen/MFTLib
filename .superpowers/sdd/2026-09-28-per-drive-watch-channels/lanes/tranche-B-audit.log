  if ("'$path -match '"'UsnJournalSyntheticTests') { return 'Partly. MftVolume.WatchUsnJournal cancellation remains, but broker EndWatch and EndWatchAck are absent.' }
  return 'Changed or removed with the broker rewrite; checked BrokerProcess, JournalBrokerHost, and FileIndex public entry points.'
}
function Get-LogicalEntry([string]"'$body, [int]$position) {
  $start = $body.LastIndexOf([char]10, $position)
  if ($start -lt 0) { $start = 0 } else { $start++ }
  $lineEnd = $body.IndexOf([char]10, $position)
  if ($lineEnd -lt 0) { $lineEnd = $body.Length }
  $line = $body.Substring($start, $lineEnd - $start)
  if (-not $line.TrimStart().StartsWith('"'- ')) { return ("'$line -replace '"'\\s+', ' ').Trim() }
  "'$rest = $body.Substring($lineEnd)
  $next = [regex]::Match($rest, '"'(?m)"'^'"\\s*-\\s')
  "'$end = if ($next.Success) { $lineEnd + $next.Index } else { [Math]::Min($body.Length, $start + 1200) }
  return ($body.Substring($start, $end - $start) -replace '"'\\s+', ' ').Trim()
}
function Get-Reason([string]"'$body, [string]$name) {
  $position = $body.IndexOf($name, [StringComparison]::Ordinal)
  $entry = Get-LogicalEntry $body $position
  $dropBecause = [regex]::Match($entry, [regex]::Escape($name) + '"'\\s+is dropped because\\s+(?<reason>.+)', 'IgnoreCase')
  if ("'$dropBecause.Success) { $reason = $dropBecause.Groups['"'reason'].Value }
  else {
    "'$colon = [regex]::Match($entry, [regex]::Escape($name) + '"'(?:\\s+["'^:]{1,80})?'"\\s*:\\s*(?<reason>.+)', 'IgnoreCase')
    if ("'$colon.Success) { $reason = $colon.Groups['"'reason'].Value }
    else {
      "'$after = $body.Substring($position, [Math]::Min(800, $body.Length - $position))
      $fallback = [regex]::Match($after, [regex]::Escape($name) + '"'\\s+is dropped because\\s+(?<reason>["'^.]+'"\\.)', 'IgnoreCase')
      "'$reason = if ($fallback.Success) { $fallback.Groups['"'reason'].Value } else { "'$entry }
    }
  }
  $reason = $reason -replace '"'\\s+Renamed ports.*"'$'"', ''
  "'$reason = $reason -replace '"'\\s+Co-Authored-By:.*"'$'"', ''
  return "'$reason.Trim()
}
function Ascii([string]$value) {
  $value = $value.Replace([char]0x2014, '"'-').Replace([char]0x2013, '-').Replace([char]0x2018, \"'\").Replace([char]0x2019, \"'\").Replace([char]0x201c, '\"').Replace([char]0x201d, '\"')
  return [regex]::Replace("'$value, '"'["'^'"\\x00-\\x7F]', '?')
}
function Cell([string]"'$value) { return (Ascii $value).Replace('"'|', '\\|').Replace([char]13, ' ').Replace([char]10, ' ') }

