     static byte[] BuildManyRecords(long startUsn, long nextUsn, int count)
     {
         using var ms = new MemoryStream();
         using var w = new BinaryWriter(ms);
         w.Write(nextUsn);
         for (var i = 0; i < count; i++)
         {
             WriteRecord(w, (ulong)(i + 1), 5, startUsn + i, 0x00000100u, "f");
         }
 
