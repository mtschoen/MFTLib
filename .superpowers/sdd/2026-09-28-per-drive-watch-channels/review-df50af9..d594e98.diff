+    [TestCleanup]
+    public void Cleanup()
+    {
+        foreach (var directory in new[] { _treeRoot, _cacheDirectory })
+        {
+            try
+            {
+                if (Directory.Exists(directory))
+                {
+                    Directory.Delete(directory, recursive: true);
+                }
+            }
+            catch (IOException)
+            {
+                // A just-unmapped block file can stay locked briefly on Windows.
+            }
+        }
+    }
