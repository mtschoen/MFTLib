<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package consumer used by smoke-package-linux.sh and smoke-package-windows.ps1.
       The native library must resolve through NuGet runtime assets; this project copies no native files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MFTLib" Version="$(MFTLibPackageVersion)" />
    <Compile Include="..\..\MFTLib.Tests\TestSupport\MftDumpFixture.cs" Link="MftDumpFixture.cs" />
  </ItemGroup>

</Project>
