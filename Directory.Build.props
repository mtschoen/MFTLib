<Project>

  <PropertyGroup>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!-- Managed defaults and analyzer/code-style settings apply only to C# projects.
       MFTLibNative.vcxproj also imports this file. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Turns the .editorconfig naming/style rules into build diagnostics. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Smoke builds have a separate restore/build tree for every referenced project. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(MFTLibSmokeArtifactsDirectory)' != ''">
    <MSBuildProjectExtensionsPath>$(MFTLibSmokeArtifactsDirectory)/$(MSBuildProjectName)/obj/</MSBuildProjectExtensionsPath>
    <IntermediateOutputPath>$(MFTLibSmokeArtifactsDirectory)/$(MSBuildProjectName)/int/$(Configuration)/</IntermediateOutputPath>
    <BaseOutputPath>$(MFTLibSmokeArtifactsDirectory)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <NuspecOutputPath>$(MFTLibSmokeArtifactsDirectory)/$(MSBuildProjectName)/nuspec/</NuspecOutputPath>
    <!-- Keep checkout outputs excluded when BaseOutputPath points outside the project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
